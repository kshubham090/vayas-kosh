# Audio is never committed
data/raw/

# Generated hypotheses/artifacts (regenerate from audit harness, don't commit)
data/transcripts/hypotheses/*
!data/transcripts/hypotheses/.gitkeep
data/transcripts/hypotheses_pilot/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets — Mozilla Data Collective token etc.
.env

# LaTeX build byproducts (regenerate via pdflatex/bibtex, don't commit)
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.toc

# OS
.DS_Store
Thumbs.db
